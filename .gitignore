# ==========================================
# EEG Wearable Platform — Git Ignore Config
# ==========================================

# 1. Environment & Secrets (SANGAT PENTING: Jangan push kredensial rahasia!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env.local

# Tetap sertakan contoh template agar pengguna lain tahu format konfigurasi
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Node.js & Frontend Artifacts
node_modules/
*/node_modules/
.next/
*/.next/
out/
build/
dist/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js & TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Go Binaries & Compilations (PENTING: server.exe ukurannya 13MB, jangan di-push!)
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/server.exe
server.exe
bin/
pkg/

# 4. Database Data & Volume Storage
pgdata/
*/pgdata/
*.db
*.sqlite
*.sqlite3

# 5. OS & IDE System Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# 6. Python / Machine Learning (Future artifacts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.pkl
*.joblib
